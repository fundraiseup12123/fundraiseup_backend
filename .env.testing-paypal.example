# Copy to .env.testing-paypal (gitignored). Used ONLY by /testing-paypal.
# Never put these values in production PAYPAL_* / Stripe vars.
#
# Local: file works. Railway: set the same names as backend service variables.
TESTING_PAYPAL_CLIENT_ID=
TESTING_PAYPAL_CLIENT_SECRET=
TESTING_PAYPAL_CURRENCY=USD
TESTING_PAYPAL_PRODUCT_NAME=UZ Testing Monthly Donation

# Live production testing (real charges — keep amounts under the cap):
TESTING_PAYPAL_ENV=live
TESTING_PAYPAL_ALLOW_LIVE=1
TESTING_PAYPAL_LIVE_MAX_AMOUNT=10

# Or sandbox-only testing:
# TESTING_PAYPAL_ENV=sandbox
